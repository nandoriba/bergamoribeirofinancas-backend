# Arquivo .env usado em produção pelo docker-compose.yml na VPS.
# Copie para /app/financeiro/.env e ajuste cada valor.

# GHCR — owner do GitHub e tags atualizadas pelos workflows
GHCR_OWNER=seu-usuario-github
BACKEND_TAG=latest
FRONTEND_TAG=latest

# Postgres compartilhado da VPS (container postgres_db na rede app_internal)
POSTGRES_DB=db_financeiro
POSTGRES_USER=financeiro_user
POSTGRES_PASSWORD=trocar-em-producao
DATABASE_URL=postgresql://financeiro_user:trocar-em-producao@postgres_db:5432/db_financeiro?schema=public

# Backend (NestJS)
JWT_SECRET=trocar-por-string-com-pelo-menos-32-chars
JWT_EXPIRES_IN=7d
WEB_ORIGIN=https://bergamoribeirofinancas.com.br
COOKIE_SECURE=true
# Crie um cliente OAuth exclusivo de produção no Google Cloud Console.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.bergamoribeirofinancas.com.br/auth/google/callback
# Segredo aleatório independente do JWT_SECRET, com pelo menos 32 caracteres.
OAUTH_ATTEMPT_SECRET=
OAUTH_ATTEMPT_KEY_VERSION=v1
OAUTH_ATTEMPT_TTL_SECONDS=300
INITIAL_ADMIN_EMAIL=admin@casaribeiro.local
INITIAL_ADMIN_PASSWORD=trocar-no-primeiro-login
INITIAL_ADMIN_NAME=Administrador Casa Ribeiro
FAMILY_NAME=Casa Ribeiro
