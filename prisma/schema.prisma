generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  admin
  user
}

enum IdentityProvider {
  google
}

enum OAuthIntent {
  login
  signup_owner
  accept_invite
  link_account
}

enum WebhookProcessingStatus {
  received
  processed
  ignored
  quarantined
  failed
}

enum RetentionRunStatus {
  running
  succeeded
  failed
}

enum SubscriptionCycle {
  MONTHLY
}

enum SubscriptionPaymentMethod {
  CARD
}

enum CheckoutProvisioningStatus {
  pending
  processing
  ready
  ambiguous
  failed
}

enum UserActionTokenPurpose {
  email_verification
  password_reset
}

enum LegalAcceptanceSource {
  local
  google
}

enum EmailOutboxStatus {
  pending
  processing
  sent
  discarded
}

enum PasswordResetRequestStatus {
  pending
  processing
  completed
  discarded
}

enum ThemePreference {
  dark
  light
}

enum ProfileStatus {
  active
  pending
  inactive
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum InviteStatus {
  active
  used
  expired
  revoked
}

enum AccountType {
  checking
  credit_card
  investment
}

enum CategoryType {
  income
  expense
}

enum TransactionType {
  income
  expense
  transfer
}

enum TransactionStatus {
  confirmed
  pending
}

enum RecurrenceType {
  none
  monthly
  yearly
}

enum InvoiceStatus {
  open
  closed
  paid
}

enum ImportBatchStatus {
  preview
  confirmed
  discarded
  failed
}

enum ImportRowStatus {
  new
  duplicate
  review
  imported
  ignored
}

enum ImportType {
  nubank_account
  nubank_credit_card
  unknown
}

enum RecurringStatus {
  active
  paused
}

enum TelegramAuthCodeKind {
  GROUP
  MEMBER
}

enum TelegramUpdateStatus {
  received
  processing
  succeeded
  failed
}

enum TelegramPendingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum TelegramFinancialOperationKind {
  TRANSACTION
  INSTALLMENT_PLAN
}

enum TelegramFinancialOperationStatus {
  CREATED
  UNDONE
}

enum AiUsageEventStatus {
  IN_FLIGHT
  SUCCEEDED
  PROVIDER_FAILED
  RESPONSE_INVALID
  AMBIGUOUS
  BLOCKED_QUOTA
}

enum AiUsageAlertKind {
  NEAR_LIMIT
  EXHAUSTED
}

enum AiUsageAlertStatus {
  PENDING
  SENT
  SUPERSEDED
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  passwordHash             String?
  name                     String
  platformRole             PlatformRole              @default(user)
  themePreference          ThemePreference           @default(dark)
  isActive                 Boolean                   @default(true)
  emailVerifiedAt          DateTime?
  authVersion              Int                       @default(0)
  familyId                 String
  family                   Family                    @relation("FamilyMembers", fields: [familyId], references: [id])
  ownedFamily              Family?                   @relation("FamilyOwner")
  profile                  MemberProfile?
  identities               UserIdentity[]
  oauthAttempts            OAuthAttempt[]            @relation("OAuthAuthenticatedUser")
  actionTokens             UserActionToken[]
  legalAcceptances         LegalAcceptance[]
  approvalsReceived        MemberApproval[]          @relation("ApprovalUser")
  invitesCreated           MemberInvite[]            @relation("InviteCreator")
  approvalsMade            MemberApproval[]          @relation("ApprovalReviewer")
  telegramAuthorizedGroups TelegramAuthorizedGroup[] @relation("TelegramGroupAuthorizer")
  telegramAuthCodes        TelegramAuthCode[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([id, familyId])
  @@index([familyId])
}

model Family {
  id                       String                    @id @default(uuid())
  name                     String
  ownerUserId              String?                   @unique
  owner                    User?                     @relation("FamilyOwner", fields: [ownerUserId, id], references: [id, familyId], onDelete: Restrict, onUpdate: Restrict)
  users                    User[]                    @relation("FamilyMembers")
  profiles                 MemberProfile[]
  invites                  MemberInvite[]
  approvals                MemberApproval[]
  categories               Category[]
  subscriptions            Subscription[]            @relation("FamilySubscriptions")
  currentSubscriptionId    String?                   @unique
  currentSubscription      Subscription?             @relation("FamilyCurrentSubscription", fields: [currentSubscriptionId, id], references: [id, familyId], onDelete: Restrict, onUpdate: Restrict)
  subscriptionPayments     SubscriptionPayment[]
  paymentWebhookEvents     PaymentWebhookEvent[]
  legalAcceptances         LegalAcceptance[]
  telegramAuthorizedGroups TelegramAuthorizedGroup[]
  aiMonthlyUsages          AiTenantMonthlyUsage[]
  pendingPaymentExpiresAt  DateTime?
  cancelledAt              DateTime?
  purgeAfter               DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([ownerUserId, id])
  @@unique([currentSubscriptionId, id])
  @@index([pendingPaymentExpiresAt])
  @@index([purgeAfter])
}

model MemberProfile {
  id                           String                        @id @default(uuid())
  displayName                  String
  status                       ProfileStatus                 @default(active)
  userId                       String                        @unique
  familyId                     String
  user                         User                          @relation(fields: [userId, familyId], references: [id, familyId], onUpdate: Restrict)
  family                       Family                        @relation(fields: [familyId], references: [id])
  accounts                     Account[]
  transactions                 Transaction[]
  invoices                     Invoice[]
  recurringTemplates           RecurringTemplate[]
  installmentPlans             InstallmentPlan[]
  monthlyOpenings              MonthlyOpening[]
  importBatches                ImportBatch[]
  telegramUserLinks            TelegramUserLink[]
  telegramAuthCodes            TelegramAuthCode[]
  telegramPendingConfirmations TelegramPendingConfirmation[]
  telegramFinancialOperations  TelegramFinancialOperation[]
  telegramMessageLogs          TelegramMessageLog[]
  aiMonthlyUsages               AiMemberMonthlyUsage[]
  aiUsageEvents                 AiUsageEvent[]
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt

  @@unique([id, familyId])
  @@unique([userId, familyId])
  @@index([familyId])
}

model UserIdentity {
  id              String           @id @default(uuid())
  provider        IdentityProvider
  providerSubject String
  observedEmail   String
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  lastUsedAt      DateTime         @default(now())

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId])
}

model OAuthAttempt {
  id                     String        @id @default(uuid())
  stateHash              String        @unique
  nonceHash              String        @unique
  browserBindingHash     String
  pkceVerifierCiphertext String
  pkceVerifierKeyVersion String
  intent                 OAuthIntent
  authenticatedUserId    String?
  authenticatedUser      User?         @relation("OAuthAuthenticatedUser", fields: [authenticatedUserId], references: [id], onDelete: Cascade)
  memberInviteId         String?
  memberInvite           MemberInvite? @relation(fields: [memberInviteId], references: [id], onDelete: Cascade)
  legalAcceptanceVersion String?
  legalAcceptedAt        DateTime?
  signupOwnerName        String?
  signupFamilyName       String?
  inviteDisplayName      String?
  returnPath             String?
  expiresAt              DateTime
  consumedAt             DateTime?
  createdAt              DateTime      @default(now())

  @@index([browserBindingHash, expiresAt])
  @@index([authenticatedUserId])
  @@index([memberInviteId])
  @@index([expiresAt, consumedAt])
}

model UserActionToken {
  id            String                 @id @default(uuid())
  purpose       UserActionTokenPurpose
  secretHash    String                 @unique
  deliveryEmail String
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  consumedAt    DateTime?
  revokedAt     DateTime?
  attempts      Int                    @default(0)
  lastAttemptAt DateTime?
  emailOutbox   EmailOutbox?
  createdAt     DateTime               @default(now())

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt, consumedAt, revokedAt])
  @@index([purpose, deliveryEmail, createdAt])
}

model LegalAcceptance {
  id            String                @id @default(uuid())
  userId        String
  familyId      String
  bundleVersion String
  source        LegalAcceptanceSource
  acceptedAt    DateTime              @default(now())
  user          User                  @relation(fields: [userId, familyId], references: [id, familyId], onDelete: Restrict, onUpdate: Restrict)
  family        Family                @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, bundleVersion])
  @@index([familyId, acceptedAt])
}

model EmailOutbox {
  id                String            @id @default(uuid())
  userActionTokenId String            @unique
  token             UserActionToken   @relation(fields: [userActionTokenId], references: [id], onDelete: Cascade)
  payloadCiphertext String?
  payloadKeyVersion String
  status            EmailOutboxStatus @default(pending)
  attempts          Int               @default(0)
  nextAttemptAt     DateTime?         @default(now())
  lockedAt          DateTime?
  providerMessageId String?
  sentAt            DateTime?
  discardedAt       DateTime?
  lastErrorCode     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, nextAttemptAt])
  @@index([lockedAt])
}

model PasswordResetRequest {
  id                String                     @id @default(uuid())
  emailCiphertext   String?
  payloadKeyVersion String
  status            PasswordResetRequestStatus @default(pending)
  attempts          Int                        @default(0)
  nextAttemptAt     DateTime?                  @default(now())
  lockedAt          DateTime?
  expiresAt         DateTime
  completedAt       DateTime?
  discardedAt       DateTime?
  lastErrorCode     String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([status, nextAttemptAt])
  @@index([lockedAt])
  @@index([expiresAt, status])
}

model MemberInvite {
  id            String           @id @default(uuid())
  token         String           @unique
  email         String?
  status        InviteStatus     @default(active)
  expiresAt     DateTime
  creatorUserId String
  familyId      String
  creator       User             @relation("InviteCreator", fields: [creatorUserId, familyId], references: [id, familyId], onUpdate: Restrict)
  family        Family           @relation(fields: [familyId], references: [id])
  approvals     MemberApproval[]
  oauthAttempts OAuthAttempt[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([id, familyId])
  @@index([familyId])
}

model MemberApproval {
  id             String         @id @default(uuid())
  status         ApprovalStatus @default(pending)
  requestedName  String
  requestedEmail String
  inviteId       String         @unique
  familyId       String
  invite         MemberInvite   @relation(fields: [inviteId, familyId], references: [id, familyId], onUpdate: Restrict)
  family         Family         @relation(fields: [familyId], references: [id])
  userId         String?
  approvedUser   User?          @relation("ApprovalUser", fields: [userId, familyId], references: [id, familyId], onDelete: Restrict, onUpdate: Restrict)
  reviewerUserId String?
  reviewer       User?          @relation("ApprovalReviewer", fields: [reviewerUserId, familyId], references: [id, familyId], onDelete: Restrict, onUpdate: Restrict)
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([familyId])
}

/// SQL enforces at most one non-cancelled subscription with an open checkout per family.
model Subscription {
  id                         String                     @id @default(uuid())
  familyId                   String
  family                     Family                     @relation("FamilySubscriptions", fields: [familyId], references: [id], onDelete: Cascade)
  currentForFamily           Family?                    @relation("FamilyCurrentSubscription")
  provider                   String                     @default("abacatepay")
  externalId                 String                     @unique
  providerSubscriptionId     String?
  providerCustomerId         String?
  providerCheckoutId         String?
  providerCheckoutUrl        String?
  providerCheckoutStatus     String?
  providerProductId          String
  providerStatus             String?
  lastProviderEvent          String?
  providerUpdatedAt          DateTime?
  lastSuccessfulPaymentAt    DateTime?
  accessPaidThrough          DateTime?
  paymentFailedAt            DateTime?
  graceUntil                 DateTime?
  cancelledAt                DateTime?
  cancelledDueTo             String?
  lastInstallmentNumber      Int?
  entitlementContractVersion String?
  amountCents                Int
  currency                   String                     @default("BRL")
  paymentMethod              SubscriptionPaymentMethod?
  providerPaymentMethod      String?
  billingCycle               SubscriptionCycle          @default(MONTHLY)
  devMode                    Boolean
  checkoutProvisioningStatus CheckoutProvisioningStatus @default(pending)
  checkoutCreationAllowed    Boolean                    @default(true)
  checkoutAttempts           Int                        @default(0)
  checkoutClaimToken         String?
  checkoutLockedAt           DateTime?
  checkoutReadyAt            DateTime?
  checkoutClosedAt           DateTime?
  checkoutCloseReason        String?
  checkoutLastErrorCode      String?
  cancelRequestedAt          DateTime?
  cancelClaimToken           String?
  cancelLockedAt             DateTime?
  cancelAttempts             Int                        @default(0)
  cancelLastErrorCode        String?
  payments                   SubscriptionPayment[]
  webhookEvents              PaymentWebhookEvent[]
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  @@unique([provider, providerSubscriptionId])
  @@unique([provider, providerCheckoutId])
  @@unique([id, familyId])
  @@index([familyId])
  @@index([familyId, providerStatus])
  @@index([provider, providerCustomerId])
  @@index([providerProductId])
  @@index([checkoutProvisioningStatus, checkoutLockedAt])
}

model SubscriptionPayment {
  id                       String                     @id @default(uuid())
  subscriptionId           String
  familyId                 String
  family                   Family                     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  subscription             Subscription               @relation(fields: [subscriptionId, familyId], references: [id, familyId], onDelete: Cascade, onUpdate: Restrict)
  providerPaymentId        String?                    @unique
  providerInstallmentId    String?
  providerCheckoutId       String?                    @unique
  providerStatus           String
  installmentNumber        Int?
  retryNumber              Int?
  maxRetry                 Int?
  amountCents              Int
  currency                 String                     @default("BRL")
  paymentMethod            SubscriptionPaymentMethod?
  providerPaymentMethod    String?
  dueAt                    DateTime?
  paidAt                   DateTime?
  failedAt                 DateTime?
  cycleStartedAt           DateTime?
  cycleEndedAt             DateTime?
  appliedAccessPaidThrough DateTime?
  providerCreatedAt        DateTime?
  providerUpdatedAt        DateTime?
  webhookEvents            PaymentWebhookEvent[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@unique([subscriptionId, providerInstallmentId])
  @@unique([id, familyId])
  @@unique([id, subscriptionId, familyId])
  @@index([subscriptionId, providerStatus])
  @@index([familyId])
  @@index([subscriptionId, installmentNumber])
  @@index([providerInstallmentId])
  @@index([dueAt])
}

model PaymentWebhookEvent {
  id                     String                  @id @default(uuid())
  provider               String                  @default("abacatepay")
  providerEventId        String
  eventType              String
  apiVersion             Int?
  devMode                Boolean?
  payloadHash            String
  sanitizedPayload       Json?
  signatureValid         Boolean
  processingStatus       WebhookProcessingStatus @default(received)
  attempts               Int                     @default(0)
  familyId               String?
  family                 Family?                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  subscriptionId         String?
  subscription           Subscription?           @relation(fields: [subscriptionId, familyId], references: [id, familyId], onDelete: Restrict, onUpdate: Restrict)
  subscriptionPaymentId  String?
  subscriptionPayment    SubscriptionPayment?    @relation(fields: [subscriptionPaymentId, subscriptionId, familyId], references: [id, subscriptionId, familyId], onDelete: Restrict, onUpdate: Restrict, map: "PaymentWebhookEvent_subscriptionPaymentId_familyId_fkey")
  providerSubscriptionId String?
  providerPaymentId      String?
  providerCheckoutId     String?
  providerFailureReason  String?
  occurredAt             DateTime?
  receivedAt             DateTime                @default(now())
  processedAt            DateTime?
  lastAttemptAt          DateTime?
  errorCode              String?

  @@unique([provider, providerEventId])
  @@index([familyId, receivedAt])
  @@index([subscriptionId, eventType])
  @@index([subscriptionPaymentId])
  @@index([provider, providerSubscriptionId])
  @@index([provider, providerPaymentId])
  @@index([provider, providerCheckoutId])
  @@index([processingStatus, receivedAt])
}

model TenantPurgeRun {
  id                   String             @id @default(uuid())
  status               RetentionRunStatus @default(running)
  startedAt            DateTime           @default(now())
  finishedAt           DateTime?
  pendingPaymentPurged Int                @default(0)
  cancelledPurged      Int                @default(0)
  errorCode            String?
  createdAt            DateTime           @default(now())

  @@index([status, finishedAt])
  @@index([startedAt])
}

model Account {
  id                  String        @id @default(uuid())
  name                String
  type                AccountType
  institution         String?
  lastFourDigits      String?
  closingDay          Int?
  dueDay              Int?
  initialBalanceCents Int           @default(0)
  memberProfileId     String
  memberProfile       MemberProfile @relation(fields: [memberProfileId], references: [id])
  transactions        Transaction[]
  invoices            Invoice[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([memberProfileId])
}

model Category {
  id                 String              @id @default(uuid())
  name               String
  type               CategoryType
  color              String
  aliases            String[]            @default([])
  familyId           String
  family             Family              @relation(fields: [familyId], references: [id])
  transactions       Transaction[]
  recurringTemplates RecurringTemplate[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([familyId, name, type])
}

model Transaction {
  id                         String                      @id @default(uuid())
  date                       DateTime
  applicationDate            DateTime
  referenceMonth             DateTime
  description                String
  amountCents                Int
  type                       TransactionType
  status                     TransactionStatus           @default(confirmed)
  recurrenceType             RecurrenceType              @default(none)
  source                     String?
  externalId                 String?
  notes                      String?
  isInvoicePayment           Boolean                     @default(false)
  isInvoiceAdjustment        Boolean                     @default(false)
  invoiceAmountCents         Int?
  memberProfileId            String
  memberProfile              MemberProfile               @relation(fields: [memberProfileId], references: [id])
  accountId                  String?
  account                    Account?                    @relation(fields: [accountId], references: [id])
  categoryId                 String?
  category                   Category?                   @relation(fields: [categoryId], references: [id])
  invoiceId                  String?
  invoice                    Invoice?                    @relation(fields: [invoiceId], references: [id])
  recurringTemplateId        String?
  recurringTemplate          RecurringTemplate?          @relation(fields: [recurringTemplateId], references: [id])
  installmentPlanId          String?
  installmentPlan            InstallmentPlan?            @relation(fields: [installmentPlanId], references: [id])
  installmentNumber          Int?
  linkedToPlanAt             DateTime?
  linkedToPlanByUserId       String?
  importRowId                String?                     @unique
  importRow                  ImportRow?                  @relation(fields: [importRowId], references: [id])
  telegramFinancialOperation TelegramFinancialOperation?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@unique([memberProfileId, externalId])
  @@unique([installmentPlanId, installmentNumber])
  @@index([memberProfileId, date])
  @@index([memberProfileId, applicationDate])
  @@index([memberProfileId, referenceMonth])
}

model Invoice {
  id              String        @id @default(uuid())
  referenceMonth  DateTime
  dueDate         DateTime?
  closingDate     DateTime?
  totalCents      Int           @default(0)
  status          InvoiceStatus @default(open)
  accountId       String
  account         Account       @relation(fields: [accountId], references: [id])
  memberProfileId String
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id])
  transactions    Transaction[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([accountId, referenceMonth])
  @@index([memberProfileId])
}

model RecurringTemplate {
  id              String          @id @default(uuid())
  description     String
  amountCents     Int
  type            TransactionType
  dayOfMonth      Int
  startsAt        DateTime
  endsAt          DateTime?
  notes           String?
  status          RecurringStatus @default(active)
  memberProfileId String
  memberProfile   MemberProfile   @relation(fields: [memberProfileId], references: [id])
  accountId       String?
  categoryId      String?
  category        Category?       @relation(fields: [categoryId], references: [id])
  transactions    Transaction[]
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([memberProfileId])
}

model InstallmentPlan {
  id                         String                      @id @default(uuid())
  description                String
  totalInstallments          Int
  paidInstallments           Int                         @default(0)
  firstInstallmentNumber     Int                         @default(1)
  firstReferenceMonth        DateTime
  monthlyAmountCents         Int
  totalAmountCents           Int
  startsAt                   DateTime
  memberProfileId            String
  memberProfile              MemberProfile               @relation(fields: [memberProfileId], references: [id])
  transactions               Transaction[]
  telegramFinancialOperation TelegramFinancialOperation?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@index([memberProfileId])
}

model MonthlyOpening {
  id              String        @id @default(uuid())
  referenceMonth  DateTime
  balanceCents    Int
  memberProfileId String
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([memberProfileId, referenceMonth])
}

model ImportBatch {
  id              String            @id @default(uuid())
  fileName        String
  type            ImportType
  status          ImportBatchStatus @default(preview)
  memberProfileId String
  memberProfile   MemberProfile     @relation(fields: [memberProfileId], references: [id])
  rows            ImportRow[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([memberProfileId])
}

model ImportRow {
  id                  String          @id @default(uuid())
  rowIndex            Int
  raw                 Json
  date                DateTime?
  description         String?
  amountCents         Int?
  externalId          String?
  suggestedCategory   String?
  status              ImportRowStatus @default(new)
  falseDuplicate      Boolean         @default(false)
  duplicateCandidates Json?
  importBatchId       String
  importBatch         ImportBatch     @relation(fields: [importBatchId], references: [id])
  transaction         Transaction?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([externalId])
}

model TelegramAuthorizedGroup {
  id                 String    @id @default(uuid())
  chatId             String    @unique
  familyId           String
  family             Family    @relation(fields: [familyId], references: [id])
  authorizedByUserId String
  authorizedByUser   User      @relation("TelegramGroupAuthorizer", fields: [authorizedByUserId, familyId], references: [id, familyId], onUpdate: Restrict)
  telegramUserLinks  TelegramUserLink[]
  createdAt          DateTime  @default(now())
  revokedAt          DateTime?

  @@unique([chatId, familyId])
  @@index([familyId])
}

model TelegramUserLink {
  id              String        @id @default(uuid())
  tgUserId        String
  chatId          String
  familyId        String
  authorizedGroup TelegramAuthorizedGroup @relation(fields: [chatId, familyId], references: [chatId, familyId], onUpdate: Restrict)
  memberProfileId String
  memberProfile   MemberProfile @relation(fields: [memberProfileId, familyId], references: [id, familyId], onUpdate: Restrict)
  createdAt       DateTime      @default(now())
  revokedAt       DateTime?

  @@unique([tgUserId, chatId])
  @@index([familyId])
  @@index([memberProfileId])
}

model TelegramAuthCode {
  id              String               @id @default(uuid())
  code            String               @unique
  kind            TelegramAuthCodeKind
  userId          String?
  user            User?                @relation(fields: [userId], references: [id])
  memberProfileId String?
  memberProfile   MemberProfile?       @relation(fields: [memberProfileId], references: [id])
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime             @default(now())

  @@index([kind, expiresAt])
  @@index([userId])
  @@index([memberProfileId])
}

model TelegramPendingConfirmation {
  id                      String                       @id
  chatId                  String
  messageId               Int?
  memberProfileId         String
  memberProfile           MemberProfile                @relation(fields: [memberProfileId], references: [id])
  tgUserId                String
  payload                 Json
  status                  TelegramPendingStatus        @default(PENDING)
  expiresAt               DateTime
  createdAt               DateTime                     @default(now())
  resolvedAt              DateTime?
  aiUsageEventId          String?                      @unique
  aiUsageEvent            AiUsageEvent?                @relation(fields: [aiUsageEventId, memberProfileId], references: [id, memberProfileId], onDelete: Restrict, onUpdate: Restrict)
  financialOperations     TelegramFinancialOperation[] @relation("OperationPendingConfirmation")
  undoFinancialOperations TelegramFinancialOperation[] @relation("UndoPendingConfirmation")

  @@index([chatId, tgUserId, status])
  @@index([expiresAt])
  @@unique([aiUsageEventId, memberProfileId])
}

model TelegramUpdate {
  updateId            String                       @id
  status              TelegramUpdateStatus         @default(received)
  attempts            Int                          @default(0)
  payload             Json
  receivedAt          DateTime                     @default(now())
  processedAt         DateTime?
  lastError           String?
  financialOperations TelegramFinancialOperation[]
  aiUsageEvent        AiUsageEvent?

  @@index([status, receivedAt])
}

model TelegramFinancialOperation {
  id                        String                           @id @default(uuid())
  idempotencyKey            String                           @unique
  kind                      TelegramFinancialOperationKind
  status                    TelegramFinancialOperationStatus @default(CREATED)
  memberProfileId           String
  memberProfile             MemberProfile                    @relation(fields: [memberProfileId], references: [id])
  tgUserId                  String
  chatId                    String
  sourceUpdateId            String?
  sourceUpdate              TelegramUpdate?                  @relation(fields: [sourceUpdateId], references: [updateId])
  sourceMessageId           Int?
  pendingConfirmationId     String?
  pendingConfirmation       TelegramPendingConfirmation?     @relation("OperationPendingConfirmation", fields: [pendingConfirmationId], references: [id])
  transactionId             String?                          @unique
  transaction               Transaction?                     @relation(fields: [transactionId], references: [id])
  installmentPlanId         String?                          @unique
  installmentPlan           InstallmentPlan?                 @relation(fields: [installmentPlanId], references: [id])
  createdAt                 DateTime                         @default(now())
  undoneAt                  DateTime?
  undoPendingConfirmationId String?
  undoPendingConfirmation   TelegramPendingConfirmation?     @relation("UndoPendingConfirmation", fields: [undoPendingConfirmationId], references: [id])
  aiUsageEventId             String?                          @unique
  aiUsageEvent               AiUsageEvent?                    @relation(fields: [aiUsageEventId, memberProfileId], references: [id, memberProfileId], onDelete: Restrict, onUpdate: Restrict)

  @@index([memberProfileId, tgUserId, status, createdAt])
  @@index([sourceUpdateId])
  @@unique([aiUsageEventId, memberProfileId])
}

model TelegramMessageLog {
  id              String         @id @default(uuid())
  chatId          String
  tgUserId        String
  messageId       Int
  memberProfileId String?
  memberProfile   MemberProfile? @relation(fields: [memberProfileId], references: [id])
  textRaw         String
  aiResponseJson  Json?
  model           String?
  tokensIn        Int?
  tokensOut       Int?
  costUsd         Decimal?       @db.Decimal(18, 6)
  aiUsageEventId  String?        @unique
  aiUsageEvent    AiUsageEvent?  @relation(fields: [aiUsageEventId, memberProfileId], references: [id, memberProfileId], onDelete: Restrict, onUpdate: Restrict)
  createdAt       DateTime       @default(now())

  @@index([createdAt])
  @@index([chatId, messageId])
  @@unique([aiUsageEventId, memberProfileId])
}

model AiTenantMonthlyUsage {
  id                         String                 @id @default(uuid())
  familyId                   String
  family                     Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  periodStart                DateTime               @db.Date
  planCode                   String
  messageLimit               Int
  nearLimitMessageCount      Int
  messages                   Int                    @default(0)
  blockedMessages            Int                    @default(0)
  tokensIn                   BigInt                 @default(0)
  tokensOut                  BigInt                 @default(0)
  estimatedCostUsd           Decimal                @default(0) @db.Decimal(18, 6)
  measurementIncompleteCount Int                    @default(0)
  financialOperations        Int                    @default(0)
  memberUsages               AiMemberMonthlyUsage[]
  events                     AiUsageEvent[]
  alerts                     AiUsageAlert[]
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  @@unique([familyId, periodStart])
  @@unique([id, familyId])
  @@unique([id, familyId, periodStart])
  @@index([periodStart])
}

model AiMemberMonthlyUsage {
  id                         String               @id @default(uuid())
  tenantUsageId              String
  familyId                   String
  tenantUsage                AiTenantMonthlyUsage @relation(fields: [tenantUsageId, familyId, periodStart], references: [id, familyId, periodStart], onDelete: Cascade, onUpdate: Restrict)
  memberProfileId            String
  memberProfile              MemberProfile        @relation(fields: [memberProfileId, familyId], references: [id, familyId], onDelete: Restrict, onUpdate: Restrict)
  periodStart                DateTime             @db.Date
  messages                   Int                  @default(0)
  blockedMessages            Int                  @default(0)
  tokensIn                   BigInt               @default(0)
  tokensOut                  BigInt               @default(0)
  estimatedCostUsd           Decimal              @default(0) @db.Decimal(18, 6)
  measurementIncompleteCount Int                  @default(0)
  financialOperations        Int                  @default(0)
  events                     AiUsageEvent[]
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@unique([familyId, memberProfileId, periodStart])
  @@unique([id, familyId])
  @@unique([id, tenantUsageId, familyId, memberProfileId])
  @@index([tenantUsageId])
  @@index([memberProfileId, periodStart])
}

model AiUsageEvent {
  id                            String                    @id @default(uuid())
  sourceUpdateId                String                    @unique
  sourceUpdate                  TelegramUpdate            @relation(fields: [sourceUpdateId], references: [updateId], onDelete: Restrict, onUpdate: Restrict)
  sourceMessageId               Int
  familyId                      String
  tenantUsageId                 String
  tenantUsage                   AiTenantMonthlyUsage      @relation(fields: [tenantUsageId, familyId], references: [id, familyId], onDelete: Cascade, onUpdate: Restrict)
  memberUsageId                 String
  memberUsage                   AiMemberMonthlyUsage      @relation(fields: [memberUsageId, tenantUsageId, familyId, memberProfileId], references: [id, tenantUsageId, familyId, memberProfileId], onDelete: Cascade, onUpdate: Restrict)
  memberProfileId               String
  memberProfile                 MemberProfile             @relation(fields: [memberProfileId, familyId], references: [id, familyId], onDelete: Restrict, onUpdate: Restrict)
  chatId                        String
  tgUserId                      String
  status                        AiUsageEventStatus         @default(IN_FLIGHT)
  provider                      String
  requestedModel                String
  usedModel                     String?
  providerRequestId             String?
  pricingVersion                String
  inputUsdPerMillionTokens      Decimal                   @db.Decimal(18, 6)
  outputUsdPerMillionTokens     Decimal                   @db.Decimal(18, 6)
  tokensIn                      Int?
  tokensOut                     Int?
  estimatedCostUsd              Decimal?                  @db.Decimal(18, 6)
  measurementComplete           Boolean                   @default(false)
  failureCode                   String?
  startedAt                     DateTime                  @default(now())
  finishedAt                    DateTime?
  messageLog                    TelegramMessageLog?
  pendingConfirmation           TelegramPendingConfirmation?
  financialOperation            TelegramFinancialOperation?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt

  @@index([familyId, startedAt])
  @@index([memberProfileId, startedAt])
  @@index([status, startedAt])
  @@unique([id, memberProfileId])
}

model AiUsageAlert {
  id              String                @id @default(uuid())
  tenantUsageId   String
  familyId        String
  tenantUsage     AiTenantMonthlyUsage  @relation(fields: [tenantUsageId, familyId], references: [id, familyId], onDelete: Cascade, onUpdate: Restrict)
  kind            AiUsageAlertKind
  status          AiUsageAlertStatus    @default(PENDING)
  attempts        Int                   @default(0)
  lastAttemptAt   DateTime?
  sentAt          DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([tenantUsageId, kind])
  @@index([familyId, status, createdAt])
}
