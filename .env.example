NODE_ENV=development
PORT=8180
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/bergamoribeirofinancas_db?schema=public
JWT_SECRET=troque-por-um-segredo-local-com-32-caracteres
JWT_EXPIRES_IN=7d
WEB_ORIGIN=http://127.0.0.1:8181
COOKIE_SECURE=false
GOOGLE_OAUTH_ENABLED=false
# Use credenciais Google separadas por ambiente. O redirect deve ser exato.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8180/auth/google/callback
# Gere um segredo aleatório exclusivo (mínimo de 32 caracteres) e não reutilize o JWT_SECRET.
OAUTH_ATTEMPT_SECRET=
OAUTH_ATTEMPT_KEY_VERSION=v1
OAUTH_ATTEMPT_TTL_SECONDS=300
# Mantenha false até o checkout/pagamento da próxima fatia estar integrado.
OWNER_SIGNUP_ENABLED=false
LEGAL_BUNDLE_VERSION=2026-08-01
PENDING_PAYMENT_TTL_DAYS=7
EMAIL_PROVIDER=disabled
# Segredos independentes, aleatórios e com no mínimo 32 caracteres.
ACTION_TOKEN_SECRET=
EMAIL_OUTBOX_SECRET=
EMAIL_OUTBOX_KEY_VERSION=v1
EMAIL_VERIFICATION_TTL_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
ACTION_TOKEN_MAX_ATTEMPTS=5
ACTION_TOKEN_HOURLY_LIMIT=5
ACTION_TOKEN_DAILY_LIMIT=10
# Limite persistente cruzando usuários/tenants para impedir bombardeio do mesmo destinatário.
ACTION_TOKEN_RECIPIENT_HOURLY_LIMIT=3
ACTION_TOKEN_RECIPIENT_DAILY_LIMIT=10
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_DELIVERY_TIMEOUT_MS=10000
RESEND_API_KEY=
EMAIL_FROM=Finanças em família <nao-responda@dominio.com.br>
SUPPORT_EMAIL=suporte@dominio.com.br
PUBLIC_API_ORIGIN=http://127.0.0.1:8180
INITIAL_ADMIN_EMAIL=admin@casaribeiro.local
INITIAL_ADMIN_PASSWORD=change-me-local
INITIAL_ADMIN_NAME=Administrador Casa Ribeiro
FAMILY_NAME=Casa Ribeiro
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PUBLIC_WEBHOOK_URL=https://dominio/api/telegram/webhook
TELEGRAM_DEV_POLLING=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TELEGRAM_AI_CONFIDENCE_THRESHOLD=0.85
TELEGRAM_PENDING_TTL_HOURS=24
TELEGRAM_UNDO_WINDOW_MINUTES=10
TELEGRAM_MESSAGE_LOG_RETENTION_DAYS=30
TELEGRAM_UPDATE_RECOVERY_MINUTES=5
ABACATEPAY_ENABLED=false
ABACATEPAY_DEV_API_KEY=
ABACATEPAY_DEV_MONTHLY_PRODUCT_ID=
ABACATEPAY_DEV_API_URL=https://api.abacatepay.com/v2
# Nunca preencha credenciais de produção no ambiente local.
ABACATEPAY_PROD_API_KEY=
ABACATEPAY_PROD_MONTHLY_PRODUCT_ID=
ABACATEPAY_PROD_API_URL=https://api.abacatepay.com/v2
ABACATEPAY_MONTHLY_AMOUNT_CENTS=2990
ABACATEPAY_PLAN_NAME=Plano familiar
ABACATEPAY_TIMEOUT_MS=10000
ABACATEPAY_RETRY_MAX=3
ABACATEPAY_RETRY_EVERY_DAYS=2
ABACATEPAY_CHECKOUT_LOCK_SECONDS=90
# O webhook fica fail-closed até o sandbox provar secret/HMAC e payloads reais.
ABACATEPAY_WEBHOOK_ENABLED=false
ABACATEPAY_WEBHOOK_HMAC_MODE=registered_secret
ABACATEPAY_WEBHOOK_CONTRACT_CONFIRMED=false
# Mantenha false até provar no sandbox que PENDING expira dentro do TTL local
# ou até o provider oferecer uma invalidação autenticada e segura do bill_.
ABACATEPAY_PENDING_EXPIRY_CONTRACT_CONFIRMED=false
ABACATEPAY_DEV_WEBHOOK_SECRET=
ABACATEPAY_PROD_WEBHOOK_SECRET=
# Esta build rejeita true: primeiro prove e implemente uma versão contratual suportada.
# A prova deve cobrir ciclo mensal, fim de mês e retry tardio.
ABACATEPAY_ENTITLEMENT_ENABLED=false
ABACATEPAY_ENTITLEMENT_CONTRACT_VERSION=
ABACATEPAY_GRACE_DAYS=3
RETENTION_CANCELLED_MONTHS=12
RETENTION_PURGE_BATCH_SIZE=50
RETENTION_PURGE_LEASE_SECONDS=900
RETENTION_PURGE_MAX_AGE_HOURS=48
